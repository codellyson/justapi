{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justapi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "justapi" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "justapi",
      // Local dev uses miniflare's own SQLite; this id is only used for
      // remote (`--remote` / deploy). Replace it after `wrangler d1 create justapi`.
      "database_id": "REPLACE_WITH_wrangler_d1_create_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "SHARE_BUCKET", "bucket_name": "justapi-shares" }]
}
