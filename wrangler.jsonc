{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justapi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "justapi.kreativekorna.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "justapi" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "justapi",
      // Local dev uses miniflare's own SQLite; this id is only used for
      // remote (`--remote` / deploy).
      "database_id": "3da0d6bd-5bc7-42f5-b901-d5b372620022",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "SHARE_BUCKET", "bucket_name": "justapi-shares" }],
  // The proxy relays arbitrary user-supplied URLs, so it is rate limited per
  // client IP. `period` only accepts 10 or 60.
  "ratelimits": [
    {
      "name": "PROXY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
